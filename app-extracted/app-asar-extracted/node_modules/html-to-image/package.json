    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "pretty-quick — staged"
    ]
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "name": "html-to-image",
  "release": {
    "extends": "@bubkoo/semantic-release-config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bubkoo/html-to-image.git"
  },
  "types": "lib/index.d.ts",
  "unpkg": "dist/html-to-image.js",
  "version": "1.3.21"
}